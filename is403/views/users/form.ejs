<%# One form for both Add and Edit. On edit, a blank password keeps the current one. %>
<%- include("../partials/header") %>
<section class="card narrow">
  <h1><%= title %></h1>
  <% if (error) { %><p class="flash error" role="alert"><%= error %></p><% } %>
  <form action="<%= action %>" method="post" class="form">
    <label for="user_email">Email</label>
    <input id="user_email" name="user_email" type="email" value="<%= record.user_email || '' %>" required>
    <label for="user_password">Password <% if (isEdit) { %><span class="muted">(leave blank to keep the current one)</span><% } %></label>
    <input id="user_password" name="user_password" type="password" autocomplete="new-password" minlength="8" <%= isEdit ? '' : 'required' %>>
    <label for="first_name">First name</label>
    <input id="first_name" name="first_name" value="<%= record.first_name || '' %>">
    <label for="last_name">Last name</label>
    <input id="last_name" name="last_name" value="<%= record.last_name || '' %>">
    <div class="actions"><button class="btn primary" type="submit">Save</button><a class="btn ghost" href="/users">Cancel</a></div>
  </form>
</section>
<%- include("../partials/footer") %>
