<%# Shared page top: brand, and the Maintain buttons that appear only after login. %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Provo Parking</title>
  <link rel="icon" href="/images/provo-parking-favicon.png">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/"><img src="/images/provo-parking-icon.png" alt="" width="32" height="32"><span>Provo Parking</span></a>
    <nav aria-label="Main">
      <% if (user) { %>
        <%# These buttons are hidden until someone logs in. One per table. %>
        <a class="btn" href="/users">Maintain Users</a>
        <a class="btn" href="/lots">Maintain Records</a>
        <a class="btn" href="/permits">Maintain Permits</a>
        <form action="/logout" method="post" class="inline"><button class="btn ghost" type="submit">Log out</button></form>
      <% } else { %>
        <a class="btn" href="/login">Log in</a>
      <% } %>
    </nav>
  </header>
  <main class="page">
    <% if (flash) { %><p class="flash <%= flash.type %>" role="status"><%= flash.text %></p><% } %>
