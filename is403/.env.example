# Copy to .env for local work. Never commit .env.
# Postgres connection string for the IS 403 database (a separate database, not the live ProvoParking one).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/is403
# Set to "true" when the database needs SSL (Supabase, Neon, Render, RDS).
DATABASE_SSL=false
# Optional: put the tables in a schema other than public.
DB_SCHEMA=public
# Long random string used to sign the session cookie.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# development locally; production when deployed (turns on secure cookies).
NODE_ENV=development
# First admin account created by `npm run seed` (the TA login). Pick your own password.
SEED_ADMIN_EMAIL=ta@provoparking.test
SEED_ADMIN_PASSWORD=CHANGE_ME
PORT=3000
