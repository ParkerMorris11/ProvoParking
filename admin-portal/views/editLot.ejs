<%# Form to edit one parking lot, filled in with its current info. %>
<%- include("partials/header") %>
<h1 class="h3 mb-3">Edit lot</h1>
<form action="/portal/editLot/<%= lot.lot_id %>" method="POST" class="card card-body shadow-sm" style="max-width: 520px;">
  <%- include("partials/lotFields", { lot: lot }) %>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a class="btn btn-outline-secondary" href="/portal/lots">Cancel</a>
  </div>
</form>
<%- include("partials/footer") %>
