<%# Form to edit one parking lot, filled in with its current values. %>
<%- include("partials/header") %>

<h1 class="h3 mb-3">Edit lot</h1>
<form action="/portal/editLot/<%= lot.lot_id %>" method="POST" class="card card-body shadow-sm" style="max-width: 520px;">
  <div class="mb-3">
    <label for="lot_name" class="form-label">Lot name</label>
    <input type="text" class="form-control" id="lot_name" name="lot_name" value="<%= lot.lot_name %>" required>
  </div>
  <div class="mb-3">
    <label for="lot_code" class="form-label">Lot code (example: 59Y)</label>
    <input type="text" class="form-control" id="lot_code" name="lot_code" value="<%= lot.lot_code %>">
  </div>
  <div class="mb-3">
    <label for="operator" class="form-label">Operator (BYU, City of Provo, or Private)</label>
    <input type="text" class="form-control" id="operator" name="operator" value="<%= lot.operator %>" required>
  </div>
  <div class="mb-3">
    <label for="total_spaces" class="form-label">Total spaces (leave blank if unknown)</label>
    <input type="number" min="0" class="form-control" id="total_spaces" name="total_spaces" value="<%= lot.total_spaces %>">
  </div>
  <div class="mb-3">
    <label for="is_free" class="form-label">Free to park?</label>
    <select class="form-select" id="is_free" name="is_free">
      <option value="false">No</option>
      <option value="true" <%= lot.is_free ? "selected" : "" %>>Yes</option>
    </select>
  </div>
  <button type="submit" class="btn btn-primary">Save</button>
  <a class="btn btn-link" href="/portal/lots">Cancel</a>
</form>

<%- include("partials/footer") %>
