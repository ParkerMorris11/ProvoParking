<%# Maintain Permits: list every permit with Edit and Delete buttons, plus Add. %>
<%- include("partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Parking permits</h1>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/">Home</a>
    <a class="btn btn-primary" href="/addPermit">Add permit</a>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr><th>Code</th><th>Name</th><th>Issuer</th><th>Description</th><th></th></tr>
    </thead>
    <tbody>
      <% permits.forEach((permit) => { %>
        <tr>
          <td><%= permit.permit_code %></td>
          <td><%= permit.permit_name %></td>
          <td><%= permit.issuer %></td>
          <td><%= permit.description %></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-primary" href="/editPermit/<%= permit.permit_id %>">Edit</a>
            <form action="/deletePermit/<%= permit.permit_id %>" method="POST" class="d-inline"
                  onsubmit="return confirm('Delete this permit?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("partials/footer") %>
