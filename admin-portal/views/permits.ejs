<%# Maintain Permits: list every permit with Edit and Delete buttons, plus Add. %>
<%# include() pastes in the shared header (navbar, Bootstrap) so we don't repeat it on every page. %>
<%- include("partials/header") %>

<%# Page title on the left; Home and Add buttons on the right. %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Parking permits</h1>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary" href="/portal">Home</a>
    <a class="btn btn-primary" href="/portal/addPermit">Add permit</a>
  </div>
</div>

<%# table-responsive lets the table scroll sideways on a phone instead of breaking the page. %>
<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr><th>Code</th><th>Name</th><th>Issuer</th><th>Description</th><th></th></tr>
    </thead>
    <tbody>
      <%# permits comes from res.render("permits", { permits: ... }) in index.js. forEach makes one table row per record. %>
      <%# The equals-sign tag prints a value safely (it escapes HTML); the plain tag runs JavaScript without printing. %>
      <% permits.forEach((permit) => { %>
        <tr>
          <td><%= permit.permit_code %></td>
          <td><%= permit.permit_name %></td>
          <td><%= permit.issuer %></td>
          <td><%= permit.description %></td>
          <td class="text-end text-nowrap">
            <%# Edit opens the edit form for this row. Delete is a POST form (not a link), and confirm() lets the user cancel. %>
            <a class="btn btn-sm btn-outline-primary" href="/portal/editPermit/<%= permit.permit_id %>">Edit</a>
            <form action="/portal/deletePermit/<%= permit.permit_id %>" method="POST" class="d-inline"
                  onsubmit="return confirm('Delete this permit?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%# Shared footer closes the page. %>
<%- include("partials/footer") %>
