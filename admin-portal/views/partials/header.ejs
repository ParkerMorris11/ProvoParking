<%# Shared top of every page: Bootstrap, the navbar, and the login-only buttons. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Provo Parking Admin</title>
  <link rel="icon" href="/images/logo.png">
  <!-- Bootstrap gives us a clean, responsive look without writing much CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar navbar-expand navbar-dark brand-bg">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/images/logo.png" alt="" width="32" height="32" class="brand-logo"> Provo Parking
      </a>
      <%# These buttons only exist on the page when the user is logged in. %>
      <% if (loggedIn) { %>
        <div class="d-flex gap-2 align-items-center">
          <span class="text-white d-none d-md-inline">Hi, <%= userName %></span>
          <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
        </div>
      <% } %>
    </div>
  </nav>
  <main class="container py-4">
