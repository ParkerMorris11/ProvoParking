<%# Form to add a new permit. %>
<%- include("partials/header") %>
<h1 class="h3 mb-3">Add permit</h1>
<form action="/portal/addPermit" method="POST" class="card card-body shadow-sm" style="max-width: 520px;">
  <%- include("partials/permitFields", { permit: {} }) %>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" href="/portal/permits">Cancel</a>
  </div>
</form>
<%- include("partials/footer") %>
