# Copy this file to .env and fill in real values. Never commit .env.
# Supabase: Connect > Transaction pooler (port 6543 works best on Vercel).
# Database server address (Supabase transaction pooler)
DB_HOST=aws-0-us-west-1.pooler.supabase.com
# 6543 = Supabase transaction pooler port (a local Postgres uses 5432)
DB_PORT=6543
# Database name (Supabase always uses postgres)
DB_NAME=postgres
# Database user (Supabase adds the project id after postgres.)
DB_USER=postgres.rikekjksneoymybnehpo
# Database password from Supabase > Project Settings > Database
DB_PASSWORD=your-database-password
# true = encrypted connection (Supabase requires it); false for a local Postgres
DB_SSL=true
# Used to sign the login cookie so it can't be faked
SESSION_SECRET=any-long-random-text
